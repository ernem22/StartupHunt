{
  "name": "startuphunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StartupHunt — sinyal radarı: toplama → normalize → embed → cluster → pattern",
  "scripts": {
    "collect": "tsx src/cli.ts collect",
    "collect:reddit-backfill": "tsx src/cli.ts collect reddit-backfill",
    "collect:reddit-incremental": "tsx src/cli.ts collect reddit-incremental",
    "pipeline": "tsx src/pipeline-cli.ts",
    "orchestrate": "tsx src/orchestrator.ts",
    "review": "tsx src/review.ts",
    "counterpart": "tsx src/counterpart.ts",
    "deepen": "tsx src/deepen.ts",
    "opportunities": "tsx src/opportunities/cli.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "check:encoding": "node scripts/check-encoding.mjs",
    "lint": "eslint .",
    "lint:python": "ruff check cluster collectors main.py config.py db.py embedding.py",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \".github/workflows/*.yml\"",
    "format:python": "ruff format --check cluster collectors main.py config.py db.py embedding.py",
    "typecheck:python": "mypy",
    "check:python": "pnpm lint:python && pnpm format:python && pnpm typecheck:python",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:encoding && pnpm test && pnpm check:python",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.23.2",
    "pnpm": ">=12"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "franc-min": "^6.2.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0"
  }
}
