# Docker compose ortam değişkenleri — kopyala: .env
POSTGRES_USER=startuphunt
POSTGRES_PASSWORD=startuphunt   # üretimde değiştir
POSTGRES_DB=startuphunt

# TEI endpoint (Windows host'tan: localhost — compose loopback'e bağlı)
TEI_URL=http://localhost:8080
DATABASE_URL=postgresql://startuphunt:startuphunt@localhost:5432/startuphunt

# Adapter API anahtarları (boş bırakılırsa ilgili adapter pas geçilir)
GITHUB_TOKEN=
STACK_EXCHANGE_KEY=
YOUTUBE_API_KEY=

# Reddit live — resmî OAuth API (v3.2: scraper iptal)
# Register: Reddit developer app + Responsible Builder Policy access talebi (2-4 hafta)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# TR karşılık araması (Windows host'tan: 8888 — compose 127.0.0.1:8888→8080)
SEARXNG_URL=http://localhost:8888
