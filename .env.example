# PostgreSQL (host port is only needed for connections from your machine)
POSTGRES_DB=startup_hunt
POSTGRES_USER=startup_hunt
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

# Pipeline credentials (required in later phases)
GEMINI_API_KEY=
PH_TOKEN=
# Alternative Product Hunt authentication: use both values if you created an OAuth app.
PH_CLIENT_ID=
PH_CLIENT_SECRET=
# Maximum items per source during each collection run.
COLLECT_LIMIT=50
# Embedding settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
# Comma-separated public sources to scan.
REDDIT_SUBREDDITS=startups,SaaS,Entrepreneur,smallbusiness
STACKEXCHANGE_SITES=stackoverflow,softwareengineering,webapps

# Local service addresses
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://localhost:8080/
# Change before exposing SearXNG outside your local machine.
SEARXNG_SECRET=replace-with-a-long-random-secret
